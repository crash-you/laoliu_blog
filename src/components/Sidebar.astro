---
import { getCollection } from "astro:content";

interface HotPost {
  title: string;
  link: string;
}

interface Props {
  hotPosts?: HotPost[];
}

// 从所有内容中动态获取标签
const articles = await getCollection("articles", ({ data }) => !data.draft);
const projects = await getCollection("projects", ({ data }) => !data.draft);
const stories = await getCollection("stories", ({ data }) => !data.draft);

// 收集所有标签（包括预设标签和自定义标签）
const allTags: string[] = [];

[...articles, ...projects, ...stories].forEach((post) => {
  // 添加预设标签
  if (post.data.tags) {
    allTags.push(...post.data.tags);
  }
  // 添加自定义标签
  if (post.data.customTags) {
    allTags.push(...post.data.customTags);
  }
});

// 统计标签出现次数并排序
const tagCounts = allTags.reduce(
  (acc, tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
    return acc;
  },
  {} as Record<string, number>,
);

// 按出现次数排序，取前10个
const popularTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10)
  .map(([tag]) => tag);

// 获取热门文章（按点赞/日期排序）
const allPosts = [...articles, ...projects, ...stories]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const defaultHotPosts: HotPost[] = allPosts.map((post) => ({
  title: post.data.title,
  link: `/${post.collection === "articles" ? "articles" : post.collection === "projects" ? "projects" : "stories"}/${post.slug}`,
}));

const { hotPosts = defaultHotPosts } = Astro.props;
---

<aside class="sidebar">
  <!-- About Author -->
  <div class="sidebar-card">
    <h4 class="sidebar-title">关于老刘</h4>
    <div class="author-info">
      <div class="author-avatar">刘</div>
      <div class="author-bio">
        <p>专注副业赚钱、个人成长</p>
        <p>帮你找到属于自己的生财之道</p>
      </div>
    </div>
    <div class="author-stats">
      <div class="stat-item">
        <span class="stat-number"
          >{articles.length + projects.length + stories.length}</span
        >
        <span class="stat-label">文章</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">100+</span>
        <span class="stat-label">资源库</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">研一</span>
        <span class="stat-label">在读</span>
      </div>
    </div>
  </div>

  <!-- Contact Card -->
  <div class="sidebar-card contact-card">
    <h4 class="sidebar-title">联系我</h4>
    <div class="contact-list">
      <div class="contact-item">
        <span class="contact-icon">微</span>
        <div class="contact-detail">
          <span class="contact-label">微信</span>
          <span class="contact-value">laoliu_money</span>
        </div>
      </div>
      <div class="contact-item">
        <span class="contact-icon">公</span>
        <div class="contact-detail">
          <span class="contact-label">公众号</span>
          <span class="contact-value">老刘的生财之道</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Hot Posts -->
  <div class="sidebar-card">
    <h4 class="sidebar-title">热门文章</h4>
    <ul class="hot-list">
      {
        hotPosts.map((post, index) => (
          <li class="hot-item">
            <span class="hot-rank">{index + 1}</span>
            <a href={post.link} class="hot-link">
              {post.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Dynamic Tags Cloud -->
  <div class="sidebar-card">
    <h4 class="sidebar-title">热门标签</h4>
    <div class="tags-cloud">
      {
        popularTags.length > 0 ? (
          popularTags.map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag)}`} class="cloud-tag">
              {tag}
            </a>
          ))
        ) : (
          <p class="no-tags">暂无标签</p>
        )
      }
    </div>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .sidebar-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
  }

  .sidebar-title {
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--border-color);
  }

  /* Author Info */
  .author-info {
    display: flex;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    background: linear-gradient(
      135deg,
      var(--accent) 0%,
      var(--accent-secondary) 100%
    );
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
  }

  .author-bio {
    flex: 1;
  }

  .author-bio p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .author-stats {
    display: flex;
    justify-content: space-between;
    text-align: center;
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--border-color);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--accent);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Contact Card */
  .contact-card {
    background: linear-gradient(
      135deg,
      var(--bg-card) 0%,
      rgba(255, 107, 53, 0.05) 100%
    );
    border-color: var(--accent);
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm);
    background: var(--bg-secondary);
    border-radius: var(--radius-md);
  }

  .contact-icon {
    width: 28px;
    height: 28px;
    background: var(--accent);
    color: white;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .contact-detail {
    display: flex;
    flex-direction: column;
  }

  .contact-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .contact-value {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
  }

  /* Hot Posts */
  .hot-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .hot-item {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
  }

  .hot-rank {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
  }

  .hot-item:nth-child(1) .hot-rank {
    background: var(--accent);
    color: white;
  }

  .hot-item:nth-child(2) .hot-rank {
    background: var(--accent-secondary);
    color: #0a0a0a;
  }

  .hot-item:nth-child(3) .hot-rank {
    background: #cd7f32;
    color: white;
  }

  .hot-link {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.4;
    transition: color var(--transition-fast);
  }

  .hot-link:hover {
    color: var(--accent);
  }

  /* Tags Cloud */
  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .cloud-tag {
    padding: var(--spacing-xs) var(--spacing-sm);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .cloud-tag:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }

  .no-tags {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
