---
interface Props {
  title: string;
  slug: string;
  description?: string;
  category: 'article' | 'project' | 'story';
  tags?: string[];
  date: Date;
  pinned?: boolean;
  featured?: boolean;
  views?: number;
  likes?: number;
  cover?: string;
}

const { title, slug, description, category, tags = [], date, pinned = false, featured = false, views = 0, likes = 0, cover } = Astro.props;

const categoryLabels: Record<string, string> = {
  article: '深度长文',
  project: '项目拆解',
  story: '学员故事'
};

const categoryColors: Record<string, string> = {
  article: 'tag-article',
  project: 'tag-project',
  story: 'tag-story'
};

const formatDate = (d: Date) => {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
};

const postUrl = `/${category === 'article' ? 'articles' : category === 'project' ? 'projects' : 'stories'}/${slug}`;
---

<article class={`post-card ${pinned ? 'pinned' : ''}`} data-category={category} data-tags={tags.join(',')} data-featured={featured ? 'true' : 'false'}>
  {cover && (
    <a href={postUrl} class="post-cover">
      <img src={cover} alt={title} loading="lazy" />
    </a>
  )}
  
  <div class="post-content">
    <div class="post-meta">
      {pinned && <span class="tag tag-pinned">📌 置顶</span>}
      <span class={`tag ${categoryColors[category]}`}>{categoryLabels[category]}</span>
      <span class="post-date">{formatDate(date)}</span>
    </div>
    
    <h3 class="post-title">
      <a href={postUrl}>{title}</a>
    </h3>
    
    {description && <p class="post-desc">{description}</p>}
    
    <div class="post-stats">
      <span class="stat" data-post-id={slug} data-stat="views">
        <span class="stat-icon">👁</span>
        <span class="stat-value">{views}</span>
      </span>
      <button class="stat like-btn" data-post-id={slug} data-stat="likes">
        <span class="stat-icon">❤️</span>
        <span class="stat-value">{likes}</span>
      </button>
    </div>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-normal);
  }
  
  .post-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }
  
  .post-card.pinned {
    border-color: var(--accent-secondary);
    background: linear-gradient(135deg, var(--bg-card) 0%, rgba(255, 215, 0, 0.05) 100%);
  }
  
  .post-cover {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  
  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }
  
  .post-card:hover .post-cover img {
    transform: scale(1.05);
  }
  
  .post-content {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }
  
  .post-date {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }
  
  .post-title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin-bottom: var(--spacing-sm);
    line-height: 1.4;
  }
  
  .post-title a {
    transition: color var(--transition-fast);
  }
  
  .post-title a:hover {
    color: var(--accent);
  }
  
  .post-desc {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .post-stats {
    display: flex;
    gap: var(--spacing-md);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--border-color);
  }
  
  .stat {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  
  .like-btn {
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  
  .like-btn:hover {
    color: var(--danger);
    transform: scale(1.1);
  }
  
  .like-btn.liked {
    color: var(--danger);
  }
  
  .stat-icon {
    font-size: 0.875rem;
  }
  
  /* Category tag colors */
  .tag-article {
    background: rgba(59, 130, 246, 0.15);
    color: #3b82f6;
    border-color: #3b82f6;
  }
  
  .tag-project {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border-color: #10b981;
  }
  
  .tag-story {
    background: rgba(168, 85, 247, 0.15);
    color: #a855f7;
    border-color: #a855f7;
  }
</style>

<script>
  // Handle likes with localStorage
  document.querySelectorAll('.like-btn').forEach(btn => {
    const postId = btn.getAttribute('data-post-id');
    const likedKey = `liked_${postId}`;
    const valueEl = btn.querySelector('.stat-value');
    
    // Check if already liked
    if (localStorage.getItem(likedKey)) {
      btn.classList.add('liked');
    }
    
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      
      if (localStorage.getItem(likedKey)) {
        // Unlike
        localStorage.removeItem(likedKey);
        btn.classList.remove('liked');
        if (valueEl) {
          valueEl.textContent = String(parseInt(valueEl.textContent || '0') - 1);
        }
      } else {
        // Like
        localStorage.setItem(likedKey, 'true');
        btn.classList.add('liked');
        if (valueEl) {
          valueEl.textContent = String(parseInt(valueEl.textContent || '0') + 1);
        }
      }
    });
  });
  
  // Increment view count (simulated with localStorage)
  document.querySelectorAll('.post-card').forEach(card => {
    const postId = card.querySelector('[data-stat="views"]')?.getAttribute('data-post-id');
    if (postId) {
      const viewsKey = `views_${postId}`;
      const currentViews = parseInt(localStorage.getItem(viewsKey) || '0');
      const viewEl = card.querySelector('[data-stat="views"] .stat-value');
      if (viewEl) {
        viewEl.textContent = String(currentViews + parseInt(viewEl.textContent || '0'));
      }
    }
  });
</script>
