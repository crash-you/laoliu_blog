---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Sidebar from "../../components/Sidebar.astro";
import { getCollection } from "astro:content";

// 从 Content Collections 获取所有项目
const allProjects = await getCollection("projects", ({ data }) => !data.draft);

// 按日期排序，置顶优先
const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.pinned && !b.data.pinned) return -1;
  if (!a.data.pinned && b.data.pinned) return 1;
  return b.data.date.getTime() - a.data.date.getTime();
});

// 获取实际分类（优先使用自定义分类）
const getActualCategory = (project: (typeof allProjects)[0]) => {
  return project.data.customSubCategory || project.data.subCategory;
};

// 动态获取所有子分类（包括自定义分类）
const allSubCategories = [
  ...new Set(allProjects.map((p) => getActualCategory(p))),
];
const subCategories = ["全部", ...allSubCategories];
---

<BaseLayout title="搞钱SOP库 - 老刘的生财之道">
  <main class="container">
    <div class="page-header">
      <h1 class="page-title">搞钱SOP库</h1>
      <p class="page-desc">具体项目操作分析、实战案例复盘</p>
    </div>

    <!-- 动态生成的子分类导航 -->
    <div class="sub-categories" id="subCategories">
      {
        subCategories.map((cat, index) => (
          <button
            class={`sub-cat-btn ${index === 0 ? "active" : ""}`}
            data-sub-category={cat}
          >
            {cat}
          </button>
        ))
      }
    </div>

    <div class="main-layout">
      <div class="content-area">
        <div class="posts-grid">
          {
            sortedProjects.map((project) => (
              <div
                class="post-wrapper"
                data-sub-category={getActualCategory(project)}
              >
                <PostCard
                  title={project.data.title}
                  slug={project.slug}
                  description={project.data.description}
                  category="project"
                  date={project.data.date}
                  pinned={project.data.pinned}
                  cover={project.data.cover}
                  tags={project.data.tags}
                />
              </div>
            ))
          }
        </div>

        {
          sortedProjects.length === 0 && (
            <div class="empty-state">
              <p>
                暂无项目，去 <a href="/admin">后台</a> 添加内容吧！
              </p>
            </div>
          )
        }
      </div>

      <Sidebar />
    </div>
  </main>
</BaseLayout>

<style>
  .page-header {
    padding: var(--spacing-xl) 0;
    margin-bottom: var(--spacing-md);
  }

  .page-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--spacing-sm);
  }

  .page-desc {
    color: var(--text-secondary);
    font-size: var(--text-base);
  }

  .sub-categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    padding: var(--spacing-md);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-xl);
  }

  .sub-cat-btn {
    padding: var(--spacing-sm) var(--spacing-md);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .sub-cat-btn:hover {
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  .sub-cat-btn.active {
    color: var(--accent);
    background: rgba(255, 107, 53, 0.15);
    border-color: var(--accent);
  }

  .content-area {
    min-width: 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }

  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }

  .post-wrapper {
    animation: fadeIn 0.3s ease forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--spacing-2xl);
    color: var(--text-muted);
  }

  .empty-state a {
    color: var(--accent);
  }
</style>

<script>
  const subCatContainer = document.getElementById("subCategories");
  const postWrappers = document.querySelectorAll(".post-wrapper");

  subCatContainer?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest(".sub-cat-btn") as HTMLElement;
    if (!btn) return;

    // Update active state
    subCatContainer
      .querySelectorAll(".sub-cat-btn")
      .forEach((b) => b.classList.remove("active"));
    btn.classList.add("active");

    // Filter posts
    const subCategory = btn.getAttribute("data-sub-category");

    postWrappers.forEach((wrapper) => {
      const wrapperCategory = wrapper.getAttribute("data-sub-category");
      const shouldShow =
        subCategory === "全部" || wrapperCategory === subCategory;

      (wrapper as HTMLElement).style.display = shouldShow ? "" : "none";
    });
  });
</script>
