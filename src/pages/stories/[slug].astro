---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map(story => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await story.render();

const formatDate = (date: Date) => {
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
};

const currentTags = [...(story.data.tags || []), ...(story.data.customTags || [])];
const storyUrl = `${Astro.site?.origin || 'https://laoliu.money'}/stories/${story.slug}`;
---

<BaseLayout 
  title={`${story.data.title} - 老刘的生财之道`}
  description={story.data.description}
  image={story.data.cover}
  type="article"
  publishedTime={story.data.date}
  tags={currentTags}
>
  <div class="container">
    <article class="article-detail">
      <header class="article-header">
        <div class="article-meta">
          <span class="article-category story">学员故事</span>
          <span class="article-date">{formatDate(story.data.date)}</span>
        </div>
        
        <h1 class="article-title">{story.data.title}</h1>
        
        {story.data.description && (
          <p class="article-desc">{story.data.description}</p>
        )}
        
        {currentTags.length > 0 && (
          <div class="article-tags">
            {currentTags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>
      
      {story.data.cover && (
        <div class="article-cover">
          <img src={story.data.cover} alt={story.data.title} />
        </div>
      )}
      
      <div class="main-layout article-layout">
        <div class="article-main">
          <div class="article-content prose">
            <Content />
          </div>
          
          <ShareButtons title={story.data.title} url={storyUrl} />
          
          <RelatedPosts 
            currentSlug={story.slug}
            currentTags={currentTags}
            collection="stories"
          />
        </div>
        
        <Sidebar />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .article-detail {
    padding-top: var(--spacing-xl);
  }
  
  .article-header {
    max-width: 800px;
    margin-bottom: var(--spacing-xl);
  }
  
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }
  
  .article-category {
    padding: var(--spacing-xs) var(--spacing-sm);
    background: rgba(168, 85, 247, 0.15);
    color: #a855f7;
    font-size: var(--text-xs);
    font-weight: 600;
    border-radius: var(--radius-sm);
  }
  
  .article-date {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  
  .article-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: var(--spacing-md);
  }
  
  @media (min-width: 768px) {
    .article-title {
      font-size: 2rem;
    }
  }
  
  .article-desc {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
  }
  
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }
  
  .article-cover {
    margin-bottom: var(--spacing-xl);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  
  .article-cover img {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
  }
  
  .article-layout {
    align-items: flex-start;
  }
  
  .article-main {
    min-width: 0;
  }
  
  .prose {
    color: var(--text-primary);
    line-height: 1.8;
    font-size: var(--text-base);
  }
  
  .prose :global(h2) {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--border-color);
  }
  
  .prose :global(h3) {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
  }
  
  .prose :global(p) {
    margin-bottom: var(--spacing-md);
  }
  
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--spacing-md);
    padding-left: var(--spacing-lg);
  }
  
  .prose :global(li) {
    margin-bottom: var(--spacing-sm);
  }
  
  .prose :global(strong) {
    color: var(--accent);
    font-weight: 600;
  }
  
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
  
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--spacing-lg) 0;
  }
</style>
