---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection } from 'astro:content';

// 从 Content Collections 获取所有故事
const allStories = await getCollection('stories', ({ data }) => !data.draft);

// 按日期排序，置顶优先
const sortedStories = allStories.sort((a, b) => {
  if (a.data.pinned && !b.data.pinned) return -1;
  if (!a.data.pinned && b.data.pinned) return 1;
  return b.data.date.getTime() - a.data.date.getTime();
});
---

<BaseLayout title="学员故事 - 老刘的生财之道">
  <div class="container">
    <div class="page-header">
      <h1 class="page-title">学员故事</h1>
      <p class="page-desc">真实学员案例分享，见证成长与蜕变</p>
    </div>
    
    <div class="main-layout">
      <div class="content-area">
        <div class="posts-grid">
          {sortedStories.map(story => (
            <PostCard 
              title={story.data.title}
              slug={story.slug}
              description={story.data.description}
              category="story"
              date={story.data.date}
              pinned={story.data.pinned}
              cover={story.data.cover}
              tags={story.data.tags}
            />
          ))}
        </div>
        
        {sortedStories.length === 0 && (
          <div class="empty-state">
            <p>暂无故事，去 <a href="/admin">后台</a> 添加内容吧！</p>
          </div>
        )}
      </div>
      
      <Sidebar />
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: var(--spacing-xl) 0;
    margin-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--border-color);
  }
  
  .page-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--spacing-sm);
  }
  
  .page-desc {
    color: var(--text-secondary);
    font-size: var(--text-base);
  }
  
  .content-area {
    min-width: 0;
  }
  
  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }
  
  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
  
  .empty-state {
    text-align: center;
    padding: var(--spacing-2xl);
    color: var(--text-muted);
  }
  
  .empty-state a {
    color: var(--accent);
  }
</style>
