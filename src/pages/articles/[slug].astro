---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await article.render();

const formatDate = (date: Date) => {
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
};

const currentTags = [...(article.data.tags || []), ...(article.data.customTags || [])];
const articleUrl = `${Astro.site?.origin || 'https://laoliu.money'}/articles/${article.slug}`;
---

<BaseLayout 
  title={`${article.data.title} - 老刘的生财之道`}
  description={article.data.description}
  image={article.data.cover}
  type="article"
  publishedTime={article.data.date}
  tags={currentTags}
>
  <div class="container">
    <article class="article-detail">
      <header class="article-header">
        <div class="article-meta">
          <span class="article-category">深度长文</span>
          {article.data.subCategory && <span class="article-sub-category">{article.data.subCategory}</span>}
          <span class="article-date">{formatDate(article.data.date)}</span>
        </div>
        
        <h1 class="article-title">{article.data.title}</h1>
        
        {article.data.description && (
          <p class="article-desc">{article.data.description}</p>
        )}
        
        {currentTags.length > 0 && (
          <div class="article-tags">
            {currentTags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>
      
      {article.data.cover && (
        <div class="article-cover">
          <img src={article.data.cover} alt={article.data.title} />
        </div>
      )}
      
      <div class="article-layout">
        <!-- TOC (Desktop) -->
        <aside class="toc-sidebar">
          <TableOfContents headings={headings} />
        </aside>
        
        <!-- Main Content -->
        <div class="article-main">
          <div class="article-content prose">
            <Content />
          </div>
          
          <ShareButtons title={article.data.title} url={articleUrl} />
          
          <RelatedPosts 
            currentSlug={article.slug}
            currentTags={currentTags}
            collection="articles"
          />
        </div>
        
        <!-- Sidebar -->
        <Sidebar />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .article-detail {
    padding-top: var(--spacing-xl);
  }
  
  .article-header {
    max-width: 800px;
    margin-bottom: var(--spacing-xl);
  }
  
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }
  
  .article-category {
    padding: var(--spacing-xs) var(--spacing-sm);
    background: rgba(59, 130, 246, 0.15);
    color: #3b82f6;
    font-size: var(--text-xs);
    font-weight: 600;
    border-radius: var(--radius-sm);
  }
  
  .article-sub-category {
    padding: var(--spacing-xs) var(--spacing-sm);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    border-radius: var(--radius-sm);
  }
  
  .article-date {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  
  .article-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: var(--spacing-md);
  }
  
  @media (min-width: 768px) {
    .article-title {
      font-size: 2rem;
    }
  }
  
  .article-desc {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
  }
  
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }
  
  .article-cover {
    margin-bottom: var(--spacing-xl);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  
  .article-cover img {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
  }
  
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    padding-bottom: var(--spacing-2xl);
  }
  
  .toc-sidebar {
    display: none;
  }
  
  @media (min-width: 1280px) {
    .article-layout {
      grid-template-columns: 200px 1fr 300px;
    }
    
    .toc-sidebar {
      display: block;
    }
  }
  
  @media (min-width: 1024px) and (max-width: 1279px) {
    .article-layout {
      grid-template-columns: 1fr 300px;
    }
  }
  
  .article-main {
    min-width: 0;
  }
  
  /* Markdown content styling */
  .prose {
    color: var(--text-primary);
    line-height: 1.8;
    font-size: var(--text-base);
  }
  
  .prose :global(h2) {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--border-color);
  }
  
  .prose :global(h3) {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
  }
  
  .prose :global(p) {
    margin-bottom: var(--spacing-md);
  }
  
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--spacing-md);
    padding-left: var(--spacing-lg);
  }
  
  .prose :global(li) {
    margin-bottom: var(--spacing-sm);
  }
  
  .prose :global(strong) {
    color: var(--accent);
    font-weight: 600;
  }
  
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
  
  .prose :global(a:hover) {
    color: var(--accent-secondary);
  }
  
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: var(--spacing-md);
    margin: var(--spacing-lg) 0;
    color: var(--text-secondary);
    font-style: italic;
  }
  
  .prose :global(code) {
    background: var(--bg-secondary);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
  }
  
  .prose :global(pre) {
    background: var(--bg-secondary);
    padding: var(--spacing-md);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: var(--spacing-lg) 0;
  }
  
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--spacing-lg) 0;
  }
</style>
